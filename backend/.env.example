# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5000

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/trustlens
# Or: MONGO_URI=mongodb://127.0.0.1:27017/trustlensDB

# JWT Authentication Secrets
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY
JWT_ACCESS_SECRET=YOUR_SECURE_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=YOUR_SECURE_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Email / SMTP Configuration (Gmail or custom SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="TrustLens AI" <security@trustlens.ai>

# Seeded Admin Configuration (Used by scripts/seedAdmin.js)
ADMIN_EMAIL=admin@trustlens.ai
ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD

# AI Intelligence API Key
AI_API_KEY=YOUR_GEMINI_API_KEY

