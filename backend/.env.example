# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5000

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/trustlens
# Or: MONGO_URI=mongodb://127.0.0.1:27017/trustlensDB

# JWT Authentication Secrets
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY
JWT_ACCESS_SECRET=YOUR_SECURE_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=YOUR_SECURE_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Email / SMTP Configuration
# Leave blank for Ethereal test emails (preview URL appears in the backend terminal).
# For real Gmail delivery, use your Gmail address and a Google App Password.
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Seeded Admin Configuration (Used by scripts/seedAdmin.js)
ADMIN_EMAIL=admin@trustlens.ai
ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD

# Optional non-production demo account seeder uses these documented defaults:
# demo.user@trustlens.ai / Password@123

# AI Intelligence API Key
AI_API_KEY=YOUR_GEMINI_API_KEY
